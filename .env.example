# Configuration d'Environnement - BankMatch Platform
# Copier ce fichier en .env et ajuster les valeurs selon votre environnement
# IMPORTANT: Ne jamais committer le fichier .env réel avec des secrets

# ==========================================
# API Endpoints
# ==========================================
# URL de base pour l'API principale
API_BASE_URL=http://localhost:8005
# URL spécifique pour le service Multi-Banking
MULTI_BANKING_URL=http://localhost:8005/banking
# URL spécifique pour le service Fraud Detection
FRAUD_DETECTION_URL=http://localhost:8005
# URL pour le service BankMatch (optionnel)
BANKMATCH_URL=http://localhost:8005/bankmatch

# ==========================================
# Authentification
# ==========================================
# Clé localStorage pour stocker le token
AUTH_TOKEN_KEY=auth_token
# Type d'authentification (Bearer, Basic, etc.)
AUTH_TOKEN_TYPE=Bearer
# Nom du header HTTP pour l'authentification
AUTH_HEADER_NAME=Authorization
# Token par défaut pour le développement (NE PAS UTILISER EN PROD)
DEFAULT_AUTH_TOKEN=

# ==========================================
# Supabase Configuration (si utilisé)
# ==========================================
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# Features Configuration
# ==========================================
# Activation de l'intégration BankMatch
BANKMATCH_INTEGRATION_ENABLED=true
# Activation des notifications temps réel (SSE)
REALTIME_NOTIFICATIONS_ENABLED=true
# Activation de l'analyse de graphe (Neo4j)
GRAPH_ANALYSIS_ENABLED=true
# Activation de la détection de fraude par ML
ML_FRAUD_DETECTION_ENABLED=true
# Activation du mode démo (données mockées)
DEMO_MODE_ENABLED=true

# ==========================================
# Multi-Banking Configuration
# ==========================================
# Taille maximale des fichiers en mégaoctets
MAX_FILE_SIZE_MB=50
# Formats de fichiers supportés (séparés par des virgules)
SUPPORTED_FORMATS=csv,camt053,mt940,pain.001,pain001
# Timeout pour l'upload de fichier en millisecondes
UPLOAD_TIMEOUT_MS=300000
# Timeout pour l'ingestion complète en millisecondes
INGESTION_TIMEOUT_MS=600000
# Nombre maximum de fichiers traités en parallèle
MAX_PARALLEL_INGESTIONS=3

# ==========================================
# Fraud Detection Configuration
# ==========================================
# Modèle ML utilisé (xgboost, isolation_forest, ensemble)
FRAUD_DETECTION_MODEL=xgboost
# Seuil de confiance par défaut (0.0 - 1.0)
DEFAULT_CONFIDENCE_THRESHOLD=0.7
# Seuil de risque élevé (0.0 - 1.0)
HIGH_RISK_THRESHOLD=0.85
# Seuil de risque moyen (0.0 - 1.0)
MEDIUM_RISK_THRESHOLD=0.7
# Seuil de risque faible (0.0 - 1.0)
LOW_RISK_THRESHOLD=0.5
# Activation du blocage automatique pour les transactions à haut risque
AUTO_BLOCK_HIGH_RISK=false

# ==========================================
# Notification Configuration
# ==========================================
# Intervalle de polling pour les notifications en millisecondes
NOTIFICATION_POLLING_INTERVAL_MS=5000
# Intervalle de reconnexion SSE en millisecondes
SSE_RECONNECT_INTERVAL_MS=3000
# Nombre maximum de tentatives de reconnexion SSE
SSE_MAX_RECONNECT_ATTEMPTS=5
# Activation des notifications par email
EMAIL_NOTIFICATIONS_ENABLED=false

# ==========================================
# Reports Configuration
# ==========================================
# Durée de cache pour les rapports en millisecondes
REPORTS_CACHE_TTL_MS=300000
# Timeout pour l'export PDF en millisecondes
PDF_EXPORT_TIMEOUT_MS=60000
# Timeout pour l'export CSV en millisecondes
CSV_EXPORT_TIMEOUT_MS=30000
# Nombre maximum de lignes dans un export CSV
MAX_CSV_EXPORT_ROWS=100000

# ==========================================
# Logging Configuration
# ==========================================
# Niveau de logging (debug, info, warn, error)
LOG_LEVEL=info
# Activation du logging des requêtes API
ENABLE_API_LOGGING=true
# Activation du logging des erreurs
ENABLE_ERROR_LOGGING=true
# Activation du logging des performances
ENABLE_PERFORMANCE_LOGGING=false

# ==========================================
# Environment
# ==========================================
# Environnement Node.js
NODE_ENV=development
# Type d'environnement (development, staging, production)
ENVIRONMENT=development
# Fuseau horaire par défaut
DEFAULT_TIMEZONE=Europe/Paris

# ==========================================
# CORS Configuration (si nécessaire)
# ==========================================
# Origines autorisées pour CORS (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
# Méthodes HTTP autorisées
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# Headers autorisés
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
# Activation des credentials CORS
CORS_ALLOW_CREDENTIALS=true

# ==========================================
# Rate Limiting Configuration
# ==========================================
# Activation du rate limiting
RATE_LIMIT_ENABLED=true
# Fenêtre de temps pour le rate limiting en millisecondes
RATE_LIMIT_WINDOW_MS=60000
# Nombre maximum de requêtes par fenêtre
RATE_LIMIT_MAX_REQUESTS=100
# Message d'erreur personnalisé pour rate limit
RATE_LIMIT_ERROR_MESSAGE=Trop de requêtes. Veuillez réessayer plus tard.

# ==========================================
# Monitoring Configuration (optionnel)
# ==========================================
# DSN Sentry pour le monitoring d'erreurs
SENTRY_DSN=your-sentry-dsn
# Activation du monitoring
ENABLE_MONITORING=false
# Niveau de capture Sentry (debug, info, warn, error)
SENTRY_LOG_LEVEL=error
# Activation du tracing distribué
ENABLE_DISTRIBUTED_TRACING=false
