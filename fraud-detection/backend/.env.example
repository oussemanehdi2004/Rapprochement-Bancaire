# ==========================================
# Service Authentication (Internal)
# ==========================================
# Secret for internal service-to-service authentication (JWT HS256)
# IMPORTANT: Use strong secrets (32+ characters) in production
INTERNAL_SERVICE_SECRET=internal_dev_secret
# Disable internal auth for development ONLY (NEVER true in production)
DISABLE_INTERNAL_AUTH=false

# ==========================================
# Fraud Detection Service Specific
# ==========================================
# Secret for Fraud Detection service identity
# IMPORTANT: Use strong secrets (32+ characters) in production
FRAUD_INTERNAL_SECRET=fraud_dev_secret_123

# ==========================================
# Database Configuration
# ==========================================
# Neo4j connection settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Supabase configuration (if used)
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key

# ==========================================
# Model Configuration
# ==========================================
# Path to the trained ML model
MODEL_PATH=model_fraud_calibrated.pkl
# Model metadata path
MODEL_METADATA_PATH=model_metadata.pkl

# ==========================================
# Feature Configuration
# ==========================================
# Feature computation settings
ENABLE_ACCOUNT_AGGREGATES=true
ENABLE_GRAPH_FEATURES=true

# ==========================================
# Threshold Configuration
# ==========================================
# Default fraud detection threshold (0.0 - 1.0)
DEFAULT_CONFIDENCE_THRESHOLD=0.7
# High risk threshold (0.0 - 1.0)
HIGH_RISK_THRESHOLD=0.85
# Medium risk threshold (0.0 - 1.0)
MEDIUM_RISK_THRESHOLD=0.7
# Low risk threshold (0.0 - 1.0)
LOW_RISK_THRESHOLD=0.5

# ==========================================
# Environment Configuration
# ==========================================
# Environment type (development, staging, production)
ENVIRONMENT=development
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ==========================================
# API Configuration
# ==========================================
# API port
API_PORT=8005
# API host
API_HOST=0.0.0.0

# ==========================================
# Monitoring Configuration
# ==========================================
# Enable Prometheus metrics
ENABLE_METRICS=true
# Metrics port
METRICS_PORT=8006
