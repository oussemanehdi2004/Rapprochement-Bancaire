# ==========================================
# Service Authentication (Internal)
# ==========================================
# Secret for internal service-to-service authentication (JWT HS256)
# IMPORTANT: Use strong secrets (32+ characters) in production
INTERNAL_SERVICE_SECRET=internal_dev_secret
# Disable internal auth for development ONLY (NEVER true in production)
DISABLE_INTERNAL_AUTH=false

# ==========================================
# Multi-Banking Service Specific
# ==========================================
# Secret for Multi-Banking service identity (used for BankMatch S2S auth)
# IMPORTANT: Use strong secrets (32+ characters) in production
MULTI_BANKING_SERVICE_SECRET=multi_banking_dev_secret

# ==========================================
# BankMatch Integration
# ==========================================
# BankMatch API base URL
# TODO: Confirm production URL with BankMatch team
BANKMATCH_BASE_URL=http://localhost:4090/api
# Enable BankMatch integration (false for standalone development, true for integration)
BANKMATCH_INTEGRATION_ENABLED=false

# ==========================================
# Fraud Detection Service
# ==========================================
# Fraud Detection service URL
FRAUD_SERVICE_URL=http://localhost:8005
# Secret for Multi-Banking to Fraud Detection service communication
# IMPORTANT: Use strong secrets (32+ characters) in production
FRAUD_INTERNAL_SECRET=fraud_dev_secret_123

# ==========================================
# Environment Configuration
# ==========================================
# Environment type (development, staging, production)
ENVIRONMENT=development
# Debug mode (payload logging, detailed errors) - NEVER true in production
DEBUG_PAYLOAD=false